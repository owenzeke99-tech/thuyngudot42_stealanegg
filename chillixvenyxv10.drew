-- Hiệu ứng Hover mượt mà cho nút
for _, btn in pairs({CheckBtn, GetKeyBtn}) do
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.1}):Play()
    end)
    btn.MouseLeave:Connect(function()
        if btn == CheckBtn then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
        else
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.3}):Play()
        end
    end)
end

-- Hàm hiệu ứng lắc mượt mà siêu êm ái bằng TweenService
local function SmoothShake()
    local info = TweenInfo.new(0.06, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    
    local t1 = TweenService:Create(MainFrame, info, {Position = originalPos + UDim2.new(0, -8, 0, 0)})
    local t2 = TweenService:Create(MainFrame, info, {Position = originalPos + UDim2.new(0, 8, 0, 0)})
    local t3 = TweenService:Create(MainFrame, info, {Position = originalPos + UDim2.new(0, -5, 0, 0)})
    local t4 = TweenService:Create(MainFrame, info, {Position = originalPos + UDim2.new(0, 5, 0, 0)})
    local t5 = TweenService:Create(MainFrame, info, {Position = originalPos})

    t1:Play()
    t1.Completed:Connect(function() t2:Play() end)
    t2.Completed:Connect(function() t3:Play() end)
    t3.Completed:Connect(function() t4:Play() end)
    t4.Completed:Connect(function() t5:Play() end)
end

-- Hàm thông báo hiện đại tích hợp hiệu ứng Pop/Slide mượt mà
local function ShowModernNotification(text, textColor, bgColor, strokeColor)
    StatusLabel.Text = text
    
    -- Tween đổi màu sắc khung Badge
    TweenService:Create(StatusFrame, TweenInfo.new(0.3), {BackgroundColor3 = bgColor}):Play()
    TweenService:Create(StatusStroke, TweenInfo.new(0.3), {Color = strokeColor}):Play()
    TweenService:Create(StatusLabel, TweenInfo.new(0.3), {TextColor3 = textColor}):Play()
    
    -- Hiệu ứng co giãn nhẹ (Pop effect) cho khung thông báo
    StatusFrame.Size = UDim2.new(0, 330, 0, 24)
    local popIn = TweenService:Create(StatusFrame, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 340, 0, 26)})
    popIn:Play()
end

-- Xử lý sự kiện Get Key
GetKeyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(GetKeyLink)
        ShowModernNotification(
            "Key link copied to clipboard!", 
            Color3.fromRGB(80, 220, 140), 
            Color3.fromRGB(20, 45, 30), 
            Color3.fromRGB(46, 204, 113)
        )
    else
        ShowModernNotification(
            "Your executor does not support auto-copy!", 
            Color3.fromRGB(255, 180, 50), 
            Color3.fromRGB(45, 35, 20), 
            Color3.fromRGB(241, 196, 15)
        )
    end
end)

-- Xử lý sự kiện Check Key
CheckBtn.MouseButton1Click:Connect(function()
    if KeyBox.Text == CorrectKey then
        ShowModernNotification(
            "Success! Loading script...", 
            Color3.fromRGB(80, 220, 140), 
            Color3.fromRGB(20, 45, 30), 
            Color3.fromRGB(46, 204, 113)
        )
        
        -- Lưu Key và thời gian hiện tại vào file để nhớ trong 24h
        if writefile then
            local dataToSave = httpService:JSONEncode({Key = CorrectKey, Time = os.time()})
            pcall(function()
                writefile(SaveFileName, dataToSave)
            end)
        end
        
        task.wait(0.8)
        ScreenGui:Destroy()
        
        -- Chạy script chính
        loadstring(game:HttpGet("https://gist.githubusercontent.com/thuyngudot42-svg/b343c9d9fa060b6deb1141b7851301f8/raw/3c92f5a61d76a6d18278160dbb8921e251ffd753/chilli-Venyxhub-ba-khi-909"))()
    else
        -- Thông báo lỗi hiện đại, tự động xóa sạch ô nhập và chạy hiệu ứng lắc siêu mượt
        ShowModernNotification(
            "Incorrect key! Please try again.", 
            Color3.fromRGB(255, 90, 90), 
            Color3.fromRGB(45, 20, 25), 
            Color3.fromRGB(235, 35, 65)
        )
        KeyBox.Text = ""
        SmoothShake()
    end
end)
