local CorrectKey = "ChilliXVenyxHubV10Key - StealAnEggVip"
local GetKeyLink = "https://link4m.net/EVJY8G"

-- Tên file lưu Key ngầm để dùng tính năng nhớ 24h
local SaveFileName = "ChilliVenyx_KeyData.json"
local httpService = game:GetService("HttpService")

-- Kiểm tra xem đã lưu key và còn hạn 24h hay không (chạy ngầm, không hiện chữ 24h lên menu)
local function CheckSavedKey()
    if readfile and isfile and isfile(SaveFileName) then
        local success, data = pcall(function()
            return httpService:JSONDecode(readfile(SaveFileName))
        end)
        if success and data and data.Key == CorrectKey then
            -- Kiểm tra thời gian (24 giờ = 86400 giây)
            if os.time() - data.Time < 86400 then
                return true
            end
        end
    end
    return false
end

-- Nếu đã lưu key hợp lệ trong 24h thì bỏ qua menu và chạy thẳng script luôn
if CheckSavedKey() then
    loadstring(game:HttpGet("https://gist.githubusercontent.com/thuyngudot42-svg/b343c9d9fa060b6deb1141b7851301f8/raw/3c92f5a61d76a6d18278160dbb8921e251ffd753/chilli-Venyxhub-ba-khi-909"))()
    return -- Dừng, không bật menu lên nữa
end

